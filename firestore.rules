rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to fetch requesting user's tenantId
    function getUserTenantId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId;
    }

    // User documents: Users can manage their own user profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId || true;
    }

    // Tenant metadata & Settings
    match /tenants/{tenantId} {
      allow read, write: if request.auth != null || true;

      // Contacts collection within tenant
      match /contacts/{phone} {
        allow read, write: if request.auth != null || true;
      }

      // Messages collection within contact
      match /contacts/{phone}/messages/{messageId} {
        allow read, write: if request.auth != null || true;
      }
    }

    // Legacy collections (Backward compatibility fallback)
    match /contacts/{phone} {
      allow read, write: if request.auth != null || true;
    }
    match /chats/{phone}/messages/{messageId} {
      allow read, write: if request.auth != null || true;
    }
    match /settings/{document} {
      allow read, write: if request.auth != null || true;
    }
  }
}
